@page "/wahoo"
@implements IDisposable
@inject IJSRuntime JSRuntime
@using Microsoft.JSInterop

<PageTitle>Wahoo Kickr POC</PageTitle>

<div class="container mx-auto p-4 pb-24">
    <h1 class="text-3xl font-bold mb-4">Wahoo Kickr Bluetooth POC</h1>

    <p class="mb-4">Cette page permet de valider la connexion Web Bluetooth à un home trainer (ex: Wahoo Kickr) et de lire la puissance.</p>

    <div class="flex gap-4 mb-4">
        <button class="btn btn-primary" @onclick="ConnectToDevice" disabled="@isConnected">Connecter au Wahoo</button>
        <button class="btn btn-secondary" @onclick="DisconnectDevice" disabled="@(!isConnected)">Déconnecter</button>
    </div>

    @if (isConnected)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
            <div class="p-4 border rounded bg-base-200 shadow-md">
                <h2 class="text-xl font-semibold mb-2">Données en direct</h2>
                <div class="stat">
                    <div class="stat-title">Puissance Instantanée</div>
                    <div class="stat-value text-primary">@currentPower W</div>
                </div>
            </div>

            <div class="p-4 border rounded bg-base-200 shadow-md">
                <h2 class="text-xl font-semibold mb-2">Contrôle ERG</h2>
                <div class="flex items-center gap-4">
                    <button class="btn btn-circle btn-outline" @onclick="DecreaseTargetPower">-</button>
                    <div class="text-2xl font-bold w-24 text-center">@targetPower W</div>
                    <button class="btn btn-circle btn-outline" @onclick="IncreaseTargetPower">+</button>
                </div>
                <button class="btn btn-accent mt-4 w-full" @onclick="SetTargetPower">Appliquer cible (@targetPower W)</button>
            </div>
        </div>
    }

    <div class="mt-4 p-2 bg-base-300 rounded">
        <p><strong>Statut :</strong> @statusMessage</p>
    </div>
</div>

@code {
    private bool isConnected = false;
    private int currentPower = 0;
    private int targetPower = 150;
    private string statusMessage = "Non connecté. Assurez-vous que le Bluetooth est activé sur votre appareil.";
    private DotNetObjectReference<Wahoo>? dotNetHelper;

    protected override void OnInitialized()
    {
        dotNetHelper = DotNetObjectReference.Create(this);
    }

    private async Task ConnectToDevice()
    {
        statusMessage = "Demande d'appairage Bluetooth en cours...";
        try
        {
            var result = await JSRuntime.InvokeAsync<string>("wahooBluetooth.connect", dotNetHelper);
            if (result == "Connecté avec succès")
            {
                isConnected = true;
            }
            statusMessage = result;
        }
        catch (Exception ex)
        {
            statusMessage = $"Erreur : {ex.Message}";
        }
    }

    private async Task DisconnectDevice()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("wahooBluetooth.disconnect");
            isConnected = false;
            currentPower = 0;
            statusMessage = "Déconnecté";
        }
        catch (Exception ex)
        {
            statusMessage = $"Erreur déconnexion : {ex.Message}";
        }
    }

    private void IncreaseTargetPower()
    {
        targetPower += 5;
    }

    private void DecreaseTargetPower()
    {
        if (targetPower > 20) targetPower -= 5;
    }

    private async Task SetTargetPower()
    {
        try
        {
            statusMessage = $"Envoi de la cible ERG : {targetPower}W...";
            var success = await JSRuntime.InvokeAsync<bool>("wahooBluetooth.setTargetPower", targetPower);
            if (success)
            {
                statusMessage = $"Cible ERG réglée sur {targetPower}W.";
            }
            else
            {
                statusMessage = "Erreur : Impossible de régler la cible ERG (le home trainer ne supporte peut-être pas le profil FTMS).";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Erreur d'envoi ERG : {ex.Message}";
        }
    }

    [JSInvokable]
    public void UpdatePower(int power)
    {
        currentPower = power;
        StateHasChanged();
    }

    public void Dispose()
    {
        dotNetHelper?.Dispose();
    }
}
