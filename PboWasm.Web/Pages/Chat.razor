@page "/chat"
@inject PboWasm.Web.Services.ChatService ChatService
@implements IDisposable

<div class="flex flex-col h-[calc(100vh-4rem)] p-4 gap-4">
    <div class="flex justify-between items-center">
        <h2 class="text-2xl font-bold">WebRTC Chat</h2>
        @if (ChatService.IsAuthenticated)
        {
            <div class="badge @(ChatService.SignalRConnected ? "badge-success" : "badge-error") gap-2">
                SignalR: @(ChatService.SignalRConnected ? "Connecté" : "Déconnecté")
            </div>
        }
    </div>

    @if (!ChatService.IsAuthenticated && ChatService.MyEmail == "")
    {
        <div class="flex-1 flex flex-col items-center justify-center gap-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24 text-primary opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <div class="text-center">
                <h3 class="text-xl font-bold mb-2">Accès réservé</h3>
                <p class="text-base-content/70 max-w-sm mb-6">Vous devez être connecté à votre compte pour accéder à la messagerie sécurisée NoKeMaRe.</p>
                <a href="auth" class="btn btn-primary px-8 rounded-full shadow-lg">Se connecter ou s'inscrire</a>
            </div>
        </div>
    }
    else if (!ChatService.SignalRConnected)
    {
        <div class="flex-1 flex flex-col items-center justify-center gap-4">
            <span class="loading loading-spinner loading-lg text-primary"></span>
            <p class="text-lg font-semibold text-base-content/70">Connexion au serveur NoKeMaRe...</p>
        </div>
    }
    else if (ChatService.SelectedUser == null)
    {
        <div class="flex-1 bg-base-200 rounded-box p-4 shadow-inner">
            <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
                <div class="w-3 h-3 bg-success rounded-full animate-pulse"></div>
                Contacts en ligne
            </h3>
            
            @if (ChatService.OnlineUsers.Count == 0)
            {
                <div class="text-center opacity-50 py-10">Personne d'autre n'est connecté pour le moment.</div>
            }
            else
            {
                <div class="grid gap-2">
                    @foreach (var user in ChatService.OnlineUsers)
                    {
                        <div class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow cursor-pointer border border-base-300" @onclick="() => ChatService.SelectUserAsync(user)">
                            <div class="card-body p-4 flex-row items-center gap-4">
                                <div class="avatar placeholder">
                                    <div class="bg-neutral-focus text-neutral-content rounded-full w-12">
                                        <span class="text-xl">@user[0].ToString().ToUpper()</span>
                                    </div>
                                </div>
                                <div class="flex-1">
                                    <h4 class="font-bold">@user</h4>
                                    <p class="text-xs opacity-70">Appuyez pour discuter</p>
                                </div>
                                <button class="btn btn-primary btn-sm btn-circle">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="flex items-center gap-2 mb-2">
            <button class="btn btn-ghost btn-sm btn-circle" @onclick="ChatService.BackToContacts">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
            </button>
            <h3 class="font-bold text-lg">Chat avec @ChatService.SelectedUser</h3>
            <div class="ml-auto badge @(ChatService.P2pState == "open" ? "badge-success" : "badge-warning") badge-sm">
                @(ChatService.P2pState == "open" ? "P2P Actif" : ChatService.P2pState)
            </div>
        </div>

        @if (ChatService.P2pState != "open")
        {
            <div class="alert alert-info shadow-lg py-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span>
                    @if (ChatService.IsInitiator) { <text>Appel de @ChatService.SelectedUser en cours...</text> }
                    else { <text>En attente d'une connexion P2P avec @ChatService.SelectedUser...</text> }
                </span>
            </div>
        }

        <div class="flex-1 overflow-y-auto bg-base-200 rounded-box p-4 space-y-2 flex flex-col">
            @foreach (var msg in ChatService.Messages)
            {
                <div class="chat @(msg.IsMe ? "chat-end" : "chat-start")">
                    <div class="chat-bubble @(msg.IsMe ? "chat-bubble-primary" : "") @(msg.IsSystem ? "chat-bubble-info text-xs italic" : "")">
                        @if (!string.IsNullOrEmpty(msg.ImageUrl))
                        {
                            <img src="@msg.ImageUrl" class="max-w-[200px] rounded-lg shadow-sm" />
                        }
                        else
                        {
                            @msg.Text
                        }
                    </div>
                    <div class="chat-footer opacity-50 text-[10px] mt-1">
                        @msg.Time.ToString("HH:mm:ss")
                    </div>
                </div>
            }
        </div>

        <div class="flex gap-2 items-center">
            <input type="file" id="imageInput" accept="image/*" class="hidden" @onchange='() => ChatService.SendImageFromInputAsync("imageInput")' />
            <label for="imageInput" class="btn btn-circle btn-ghost" disabled="@(ChatService.P2pState != "open")">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
            </label>
            <input type="text" @bind="currentMessage" @bind:event="oninput"
                   @onkeydown="HandleKeyDown"
                   class="input input-bordered flex-1"
                   placeholder="Tapez votre message..."
                   disabled="@(ChatService.P2pState != "open")" />
            <button class="btn btn-primary" @onclick="SendMessage" disabled="@(ChatService.P2pState != "open")">
                Envoyer
            </button>
        </div>
    }
</div>

@code {
    private string currentMessage = "";

    protected override async Task OnInitializedAsync()
    {
        ChatService.OnStateChanged += StateHasChanged;
        await ChatService.InitializeAsync();
    }

    public void Dispose()
    {
        ChatService.OnStateChanged -= StateHasChanged;
    }

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(currentMessage))
        {
            await ChatService.SendMessageAsync(currentMessage);
            currentMessage = "";
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }
}
