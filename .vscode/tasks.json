{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-css",
            "type": "shell",
            "command": "npm run build:css",
            "options": {
                "cwd": "${workspaceFolder}/PboWasm.Web"
            },
            "problemMatcher": []
        },
        {
            "label": "watch-css",
            "type": "shell",
            "command": "npm run watch:css",
            "options": {
                "cwd": "${workspaceFolder}/PboWasm.Web"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/PboWasm.Web/PboWasm.Web.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoColor"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-api",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/PboWasm.Api/PboWasm.Api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoColor"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
